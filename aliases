unamestr=`uname`

alias ll='ls -lh'
alias la='ls -Alh'

# Git Aliases
alias gst='git status'
alias P='git push'
alias pu='git pull'
alias p='git pull'

# Docker Aliases
alias d='docker'
alias di='docker images'
alias drmi='docker rmi'
alias dc='docker compose'
alias dp='docker ps'
alias dpa='docker ps -a'

function removeDockerContainers() {
  docker rm $(docker ps -a -q)
}

alias tasks='mvapi files edit --path scratchspace/short-term-tasks.md'

# Darwin (macOS) specific aliases and functions
if [[ "$unamestr" == 'Darwin' ]]; then
  alias ls='ls --color=auto'
  alias grep='grep --color=auto'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
  alias n='nvim'
  alias vim='nvim'
  alias t='tmux'

  alias j11='export JAVA_HOME="$(mise where java@corretto-11.0.31.11.1)"'
  alias j25='export JAVA_HOME="$(mise where java@25)"'
  alias jversion='java -version && echo "JAVA_HOME: $JAVA_HOME"'

  function parse_git_branch {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
  }

  # Git worktrees (copied from Omarchy's bash fns/worktrees)
  # Create a new worktree and branch next to the current repository and jump into it.
  ga() {
    if [[ -z "$1" ]]; then
      echo "Usage: ga [branch name]"
      return 1
    fi

    local branch="$1"
    local base="$(basename "$PWD")"
    local wt_path="../${base}--${branch}"

    git worktree add -b "$branch" "$wt_path"
    command mise trust "$wt_path" 2> /dev/null
    cd "$wt_path"
  }

  # Remove the current worktree and its branch (asks for confirmation first).
  gd() {
    local confirm="y"
    if command -v gum > /dev/null; then
      gum confirm "Remove worktree and branch?" || return 0
    else
      read -r -p "Remove worktree and branch? [y/N] " confirm
      [[ "$confirm" =~ ^[Yy]$ ]] || return 0
    fi

    local cwd base branch root worktree

    cwd="$(pwd)"
    worktree="$(basename "$cwd")"

    # split on first `--`
    root="${worktree%%--*}"
    branch="${worktree#*--}"

    # Protect against accidentally nuking a non-worktree directory
    if [[ "$root" != "$worktree" ]]; then
      cd "../$root"
      git worktree remove "$cwd" --force || return 1
      git branch -D "$branch"
    fi
  }

# Linux specific aliases and functions
elif [[ "$unamestr" == 'Linux' ]]; then
  # Hermes Agent
  alias hermes='docker run -it --rm -e HERMES_UID=1000 -e HERMES_GID=1000 -v ~/.hermes:/opt/data nousresearch/hermes-agent'
fi
